diff --git a/app/src/main/java/com/stepshare/core/network/interceptor/AuthInterceptor.kt b/app/src/main/java/com/stepshare/core/network/interceptor/AuthInterceptor.kt
index 5043f22..5675e4c 100644
--- a/app/src/main/java/com/stepshare/core/network/interceptor/AuthInterceptor.kt
+++ b/app/src/main/java/com/stepshare/core/network/interceptor/AuthInterceptor.kt
@@ -8,22 +8,26 @@ import okhttp3.Response
 class AuthInterceptor(private val tokenManager: TokenManager) : Interceptor {
     override fun intercept(chain: Interceptor.Chain): Response {
         val original = chain.request()
+        val path = original.url.encodedPath
 
-        // Skip auth header for login/register
-        if (original.url.encodedPath.contains("/auth/")) {
+        // Only login/register go without a token. (Previously every "/auth/" path was
+        // skipped, so DELETE /auth/me was sent unauthenticated.)
+        if (path.endsWith("/auth/login") || path.endsWith("/auth/register")) {
             return chain.proceed(original)
         }
 
         val token = runBlocking { tokenManager.getToken() }
+            ?: return chain.proceed(original)
 
-        val request = if (token != null) {
-            original.newBuilder()
-                .header("Authorization", "Bearer $token")
-                .build()
-        } else {
-            original
-        }
+        val response = chain.proceed(
+            original.newBuilder().header("Authorization", "Bearer $token").build()
+        )
 
-        return chain.proceed(request)
+        // Token expired or account gone: drop the dead session so the app goes back to
+        // the login screen instead of silently failing forever (the "reinstall to fix" bug).
+        if (response.code == 401) {
+            runBlocking { tokenManager.clearSessionIfToken(token) }
+        }
+        return response
     }
 }
diff --git a/app/src/main/java/com/stepshare/features/auth/data/repository/AuthRepositoryImpl.kt b/app/src/main/java/com/stepshare/features/auth/data/repository/AuthRepositoryImpl.kt
index ccfbbec..7ff7bf1 100644
--- a/app/src/main/java/com/stepshare/features/auth/data/repository/AuthRepositoryImpl.kt
+++ b/app/src/main/java/com/stepshare/features/auth/data/repository/AuthRepositoryImpl.kt
@@ -8,6 +8,10 @@ import com.Consnow.core.network.dto.RegisterRequest
 import com.Consnow.features.auth.domain.AuthRepository
 import android.content.Context
 import com.google.firebase.analytics.FirebaseAnalytics
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
 
 class AuthRepositoryImpl(
     private val apiService: ApiService,
@@ -73,4 +77,26 @@ class AuthRepositoryImpl(
     }
 
     override suspend fun isLoggedIn(): Boolean = tokenManager.getToken() != null
+
+    override fun observeLoggedIn(): Flow<Boolean> =
+        tokenManager.tokenFlow.map { it != null }.distinctUntilChanged()
+
+    override suspend fun refreshTokenIfStale() {
+        val token = tokenManager.getToken() ?: return
+        val issuedAt = tokenManager.issuedAtMs(token)
+        if (issuedAt != null && System.currentTimeMillis() - issuedAt < REFRESH_AFTER_MS) return
+        try {
+            val response = apiService.refreshToken()
+            val fresh = response.body()?.token
+            if (response.isSuccessful && fresh != null) tokenManager.saveToken(fresh)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (_: Exception) {
+            // offline: try again on the next call
+        }
+    }
+
+    private companion object {
+        const val REFRESH_AFTER_MS = 24 * 60 * 60 * 1000L
+    }
 }
